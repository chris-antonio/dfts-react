{
  "name": "@chris-antonio/dfts-react",
  "version": "0.1.0",
  "description": "DFTS design system: React components, design tokens and styles",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": { "dfts-mcp": "./mcp/server.mjs" },
  "exports": {
    ".": { "types": "./lib/index.d.ts", "import": "./lib/index.js" },
    "./styles.css": "./lib/styles.css",
    "./tokens.css": "./styles/tokens.css",
    "./package.json": "./package.json"
  },
  "sideEffects": ["*.css"],
  "files": ["lib", "styles", "mcp", "DFTS.md", "DFTS-tokens.md", "components.json", "llms.txt", "AGENTS.md"],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "prepare": "npm run build",
    "test": "node scripts/smoke-test.mjs",
    "docs": "node scripts/build-docs.mjs",
    "mcp": "node mcp/server.mjs",
    "storybook": "npm run build && storybook dev -p 6006",
    "build-storybook": "npm run build && storybook build -o storybook-static"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.6",
    "vite": "^7.3.8"
  },
  "repository": { "type": "git", "url": "git+https://github.com/chris-antonio/dfts-react.git" },
  "publishConfig": { "access": "public" }
}
